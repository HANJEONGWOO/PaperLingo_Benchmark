# Public team workspace. Set false + PAPERLINGO_PASSWORD for a private workspace.
PAPERLINGO_HOST=0.0.0.0
PAPERLINGO_PORT=4173
PAPERLINGO_PUBLIC_ACCESS=true
PAPERLINGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],hjw.iptime.org
PAPERLINGO_PASSWORD=
PAPERLINGO_PUBLIC_READ=false
PAPERLINGO_SECURE_COOKIE=false

# Default: four immediate code checks; no LLM health requests or inference.
PAPERLINGO_REVIEW_MODE=code

# Optional legacy review: set PAPERLINGO_REVIEW_MODE=llm to enable.
# Local OpenAI-compatible server. No paid API or key is required for the bundled runtime.
JUDGE_BASE_URL=http://127.0.0.1:11434/v1
JUDGE_MODEL=Qwen/Qwen3-8B
JUDGE_API_KEY=
JUDGE_CONCURRENCY=1
# Internal chunk size; the server automatically processes every chunk.
JUDGE_BATCH_SIZE=20
JUDGE_TIMEOUT=300

# Optional example generator, only called when the CLI is explicitly run.
GENERATOR_BASE_URL=http://127.0.0.1:11434/v1
GENERATOR_MODEL=Qwen/Qwen3-8B
GENERATOR_API_KEY=
GENERATOR_TIMEOUT=300
