[Unit]
Description=PaperLingo GitHub Actions deployment runner
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/paperlingo-runner
ExecStart=%h/.local/share/paperlingo-runner/run.sh
Restart=always
RestartSec=10
TimeoutStopSec=120
KillMode=process
UMask=0077
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
